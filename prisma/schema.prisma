/// Pre legajo: postulante en proceso de ingreso. Espeja la nullability de `employees`
/// para los datos personales y de contacto; de los datos laborales solo tiene el sector
/// y el puesto propuestos. Al aprobarse se materializa un `employees` y queda como historial.
model pre_employees {
  id                             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at                     DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at                     DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)
  company_id                     String                    @db.Uuid
  pre_file_number                String
  status                         pre_employee_status_enum  @default(en_proceso)

  // Datos personales (misma nullability que employees)
  firstname                      String
  lastname                       String
  cuil                           String
  document_type                  document_type_enum?
  document_number                String
  born_date                      String?
  nationality                    nationality_enum?
  birthplace                     String                    @db.Uuid
  gender                         gender_enum?
  marital_status                 marital_status_enum?
  level_of_education             level_of_education_enum?
  picture                        String?

  // Datos de contacto (misma nullability que employees)
  street                         String
  street_number                  String
  province                       BigInt
  city                           BigInt?
  postal_code                    String?
  phone                          String
  email                          String?

  // Datos laborales propuestos (unicos dos campos laborales del pre legajo)
  proposed_hierarchical_position String?                   @db.Uuid
  proposed_company_position      String?                   @db.Uuid

  // Revision y conversion
  rejection_reason               String?
  reviewed_by                    String?                   @db.Uuid
  reviewed_at                    DateTime?                 @db.Timestamptz(6)
  created_by                     String?                   @db.Uuid
  employee_id                    String?                   @unique @db.Uuid

  company                        company                   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  countries                      countries                 @relation(fields: [birthplace], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provinces                      provinces                 @relation(fields: [province], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cities                         cities?                   @relation(fields: [city], references: [id], onDelete: NoAction, onUpdate: NoAction)
  hierarchy                      hierarchy?                @relation(fields: [proposed_hierarchical_position], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company_positions              company_positions?        @relation(fields: [proposed_company_position], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employees                      employees?                @relation(fields: [employee_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  created_by_profile             profile?                  @relation("pre_employees_created_byToprofile", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewed_by_profile            profile?                  @relation("pre_employees_reviewed_byToprofile", fields: [reviewed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents_pre_employees        documents_pre_employees[]

  @@unique([company_id, pre_file_number])
  @@index([company_id, status])
  @@schema("public")
}

