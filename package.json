{
  "name": "s-code-control",
  "version": "0.1.0",
  "private": true,
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "format": "npx prettier --write .",
    "prepare": "husky",
    "check-types": "tsc --noEmit",
    "gentypes": "npx supabase gen types typescript --project-id vvrckjjyrwqzpbaatemz --schema public > database.types.ts",
    "genlocaltypes": "npx supabase gen types typescript --local > database.types.ts",
    "local": "npx supabase start && next dev",
    "pull-changes": "npx supabase db diff --linked -f",
    "pull-data": "npx supabase db dump --linked --data-only -f supabase/seed.sql",
    "create-migration": "npx supabase db diff -f",
    "migration-status": "npx supabase migration list",
    "push-migrations": "npx supabase db push",
    "cypress": "cypress open",
    "cypress:headless": "cypress run --spec 'cypress/e2e/**/*.cy.ts'",
    "test:e2e": "cypress run --spec 'cypress/e2e/**/*.cy.ts'",
    "test:e2e:open": "cypress open",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status"
  },
