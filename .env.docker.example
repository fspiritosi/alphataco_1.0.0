# Postgres / MinIO (compose)
POSTGRES_PASSWORD=cambiar
# Puerto 5432 ocupado en este host por otro proyecto (ecommerce-postgres-1):
# se remapea a 55432. Ajustar si en tu maquina 5432 esta libre.
POSTGRES_PORT=55432
S3_ACCESS_KEY=alphataco
S3_SECRET_KEY=cambiar-cambiar
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Puertos 9000/9001 ocupados en este host por otro proyecto (credere-minio):
# se remapean a 29000/29001. Ajustar si en tu maquina estan libres.
MINIO_PORT=29000
MINIO_CONSOLE_PORT=29001
# App
APP_PORT=3000
APP_DOMAIN=localhost
# Corre `prisma migrate deploy` en el entrypoint del contenedor `app` al arrancar.
# Poner en `false` solo si las migraciones se aplican por otro medio (ej. un paso
# de deploy separado) y no se quiere que el contenedor las reintente en cada start.
RUN_MIGRATIONS=true
# Puerto 80 ocupado en este host (otro servicio local); se remapea a 8080.
# 443 esta libre y se deja en su default. Ajustar segun disponibilidad.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=443
JOBS_TOKEN=cambiar
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PROJECT_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_LOGS=false
# Supabase (solo hasta P4: auth y storage siguen en Supabase)
# NEXT_PUBLIC_SUPABASE_URL y NEXT_PUBLIC_SUPABASE_ANON_KEY son OBLIGATORIAS
# para que `next build` no falle: quedan embebidas en el bundle de cliente y
# `supabaseBrowser()` las lee en componentes que se prerenderizan en build time
# (ej: src/app/maintenance/page.tsx). Confirmado en este entorno: dejarlas
# vacias hace fallar `docker compose build app` con
# "Error: Your project's URL and Key are required to create a Supabase client!"
# al prerenderizar /maintenance.
# Completar con los valores reales del Supabase local/dev, o con un placeholder
# (ej: http://localhost:54321 y una key ficticia) si solo se busca validar el build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de MinIO/S3 para las fotos de Preparte (fallback 'preparte-img' en el código
# si queda vacía: src/features/Operaciones/Preparte/actions/preparte.ts y PreparteForm.tsx)
NEXT_PUBLIC_PREPARTE_BUCKET=preparte-img
# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# SMTP (P5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
# Nombre del remitente en los emails salientes (fallback 'CodeControl' en
# src/app/api/send/route.ts si queda vacía)
EMAIL_FROM_NAME=alphataco
# TaskApp
TASKAPP_BASE_URL=
TASKAPP_PROJECT_API_KEY=
