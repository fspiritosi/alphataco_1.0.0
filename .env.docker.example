# Postgres / MinIO (compose)
POSTGRES_PASSWORD=cambiar
# Puertos de host. Si alguno esta ocupado en tu maquina, cambialo aca (nunca en
# docker-compose.yml). Ver docs/desarrollo/entornos.md.
POSTGRES_PORT=5432
S3_ACCESS_KEY=alphataco
S3_SECRET_KEY=cambiar-cambiar
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# MinIO NO se publica en internet: el navegador nunca le habla. La app lo alcanza por la
# red del compose (el servicio `app` fija S3_ENDPOINT=http://minio:9000) y sirve los
# archivos por /api/files. Para correr `npm run dev` fuera de Docker, apuntar S3_ENDPOINT
# al puerto publicado de abajo (MINIO_PORT).
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# App
APP_PORT=3000
APP_DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
JOBS_TOKEN=cambiar
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PROJECT_URL=http://localhost:3000
NEXT_PUBLIC_SHOW_LOGS=false
# Auth (Better Auth)
# BETTER_AUTH_SECRET firma las cookies de sesion: generar con `openssl rand -base64 32`.
# Cambiarla invalida todas las sesiones abiertas.
BETTER_AUTH_SECRET=cambiar-cambiar-cambiar
# Login con Google (opcional): si estan vacias, el boton de Google no se muestra.
# Redirect URI a registrar en Google Cloud: <NEXT_PUBLIC_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# SMTP — P4 lo usa para la invitacion de usuario y la recuperacion de contrasena
# (emisor minimo en src/shared/lib/mailer.ts). Vacio = los mails NO se envian y el
# enlace se loguea, que alcanza para probar el flujo en desarrollo. P5 generaliza
# esto con colas, reintentos y plantillas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
# Nombre del remitente en los emails salientes (fallback 'CodeControl' en
# src/app/api/send/route.ts si queda vacía)
EMAIL_FROM_NAME=alphataco
# TaskApp
TASKAPP_BASE_URL=
TASKAPP_PROJECT_API_KEY=
