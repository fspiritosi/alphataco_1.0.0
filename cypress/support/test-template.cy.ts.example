/**
 * Template para Tests E2E
 * 
 * Copiar este archivo y renombrar según la convención:
 * - Con subtabs: {tab}--{subtab}.cy.ts
 * - Sin subtabs: {tab}.cy.ts
 * 
 * Ejemplo: comercial/comerce--customers.cy.ts
 */

/**
 * data-testid agregados en este test:
 * - create-{entity}-button: Botón para abrir modal de creación
 * - {entity}-name-input: Input del nombre
 * - {entity}-{field}-input: Input de cada campo
 * - submit-{entity}-button: Botón para enviar formulario
 * - edit-button-{id}: Botón de editar en cada fila
 * - delete-button-{id}: Botón de eliminar en cada fila
 * - confirm-delete-button: Botón de confirmar eliminación
 * - cancel-delete-button: Botón de cancelar eliminación
 */

describe('Módulo - Funcionalidad', () => {
  // Configuración antes de cada test
  beforeEach(() => {
    // Login con credenciales de testing
    const email = Cypress.env('TEST_EMAIL') || 'testing@e2e.com';
    const password = Cypress.env('TEST_PASSWORD') || 'Testing123!';
    cy.login(email, password);

    // Navegar a la URL específica del tab/subtab
    cy.visit('/dashboard/ruta?tab=main-tab&subtab=sub-tab');
  });

  describe('Navigation', () => {
    it('should navigate to the correct tab', () => {
      // Verificar que estamos en la URL correcta
      cy.url().should('include', '/dashboard/ruta');
      cy.url().should('include', 'tab=main-tab');
      cy.url().should('include', 'subtab=sub-tab');

      // Verificar que el tab está activo
      cy.get('[data-testid="main-tab-main-tab"]').should('exist');
      cy.get('[data-testid="sub-tab-sub-tab"]').should('exist');

      // Verificar que la página cargó correctamente
      cy.get('body').should('exist');
      cy.wait(2000);
    });
  });

  describe('READ - View existing data', () => {
    it('should display existing records in the table', () => {
      // Verificar que la tabla existe y tiene datos
      cy.get('table').should('exist');
      
      // Verificar que se muestran registros de testing
      cy.contains('Registro Testing E2E', { timeout: 10000 }).should('be.visible');
      
      // Verificar columnas específicas
      cy.contains('Nombre').should('be.visible');
      cy.contains('Estado').should('be.visible');
    });

    it('should display correct data in table rows', () => {
      // Verificar datos específicos de un registro de testing
      cy.contains('tr', 'Registro Testing E2E').within(() => {
        cy.contains('Activo').should('be.visible');
        cy.get('[data-testid^="edit-button-"]').should('exist');
        cy.get('[data-testid^="delete-button-"]').should('exist');
      });
    });
  });

  describe('CREATE - Add new record', () => {
    it('should open create modal when clicking add button', () => {
      // Click en el botón de crear
      cy.get('[data-testid="create-entity-button"]', { timeout: 10000 }).click();

      // Verificar que el modal se abre
      cy.contains('Crear Nuevo Registro').should('be.visible');
      
      // Verificar que los campos del formulario existen
      cy.get('[data-testid="entity-name-input"]').should('be.visible');
    });

    it('should create a new record successfully', () => {
      // Abrir modal
      cy.get('[data-testid="create-entity-button"]').click();
      cy.contains('Crear Nuevo Registro').should('be.visible');
      cy.wait(1000);

      // Llenar formulario
      const timestamp = Date.now();
      cy.get('[data-testid="entity-name-input"]').type(`Registro E2E ${timestamp}`);
      cy.get('[data-testid="entity-description-input"]').type('Descripción de prueba');
      
      // Si hay selects
      cy.get('[data-testid="entity-type-select-button"]').click();
      cy.wait(500);
      cy.get('[data-testid="entity-type-option-1"]').click();

      // Enviar formulario
      cy.get('[data-testid="submit-entity-button"]').click();

      // Verificar mensaje de éxito
      cy.contains('creado exitosamente', { timeout: 10000 }).should('be.visible');

      // Verificar que el modal se cierra
      cy.contains('Crear Nuevo Registro').should('not.exist');

      // Verificar que el nuevo registro aparece en la tabla
      cy.contains(`Registro E2E ${timestamp}`).should('be.visible');
    });

    it('should show validation errors for required fields', () => {
      // Abrir modal
      cy.get('[data-testid="create-entity-button"]').click();

      // Intentar enviar sin llenar campos requeridos
      cy.get('[data-testid="submit-entity-button"]').click();

      // Verificar mensajes de error
      cy.contains('Campo requerido').should('be.visible');
      // O verificar errores específicos
      cy.contains('El nombre es requerido').should('be.visible');
    });
  });

  describe('UPDATE - Edit existing record', () => {
    it('should open edit modal with pre-filled data', () => {
      // Click en el botón de editar del registro de testing
      cy.get('[data-testid="edit-button-test-id"]', { timeout: 10000 }).click();

      // Verificar que el modal se abre
      cy.contains('Editar Registro').should('be.visible');

      // Verificar que los campos están pre-llenados
      cy.get('[data-testid="entity-name-input"]').should('have.value', 'Registro Testing E2E');
    });

    it('should update an existing record successfully', () => {
      // Abrir modal de edición
      cy.get('[data-testid="edit-button-test-id"]').click();
      cy.contains('Editar Registro').should('be.visible');
      cy.wait(1000);

      // Modificar campos
      const timestamp = Date.now();
      cy.get('[data-testid="entity-name-input"]').clear().type(`Registro Editado ${timestamp}`);
      cy.get('[data-testid="entity-description-input"]').clear().type('Descripción actualizada');

      // Guardar cambios
      cy.get('[data-testid="submit-entity-button"]').click();

      // Verificar mensaje de éxito
      cy.contains('actualizado exitosamente', { timeout: 10000 }).should('be.visible');

      // Verificar que el modal se cierra
      cy.contains('Editar Registro').should('not.exist');

      // Verificar que los cambios se reflejan en la tabla
      cy.contains(`Registro Editado ${timestamp}`).should('be.visible');
    });
  });

  describe('DELETE - Remove record', () => {
    beforeEach(() => {
      // Crear un registro para eliminar
      cy.get('[data-testid="create-entity-button"]').click();
      cy.wait(1000);
      
      const timestamp = Date.now();
      cy.get('[data-testid="entity-name-input"]').type(`Para Eliminar ${timestamp}`);
      cy.get('[data-testid="submit-entity-button"]').click();
      
      cy.contains('creado exitosamente', { timeout: 10000 }).should('be.visible');
      cy.wait(2000);
    });

    it('should delete a record with confirmation', () => {
      // Buscar el registro y hacer click en eliminar
      cy.contains('tr', 'Para Eliminar', { timeout: 10000 }).within(() => {
        cy.get('[data-testid^="delete-button-"]').click();
      });

      // Verificar modal de confirmación
      cy.contains('¿Estás seguro').should('be.visible');

      // Confirmar eliminación
      cy.get('[data-testid="confirm-delete-button"]').click();

      // Verificar mensaje de éxito
      cy.contains('eliminado exitosamente', { timeout: 10000 }).should('be.visible');

      // Verificar que el registro ya no está en la tabla
      cy.contains('Para Eliminar').should('not.exist');
    });

    it('should cancel delete operation', () => {
      // Buscar el registro y hacer click en eliminar
      cy.contains('tr', 'Para Eliminar', { timeout: 10000 }).within(() => {
        cy.get('[data-testid^="delete-button-"]').click();
      });

      // Verificar modal de confirmación
      cy.contains('¿Estás seguro').should('be.visible');

      // Cancelar eliminación
      cy.get('[data-testid="cancel-delete-button"]').click();

      // Verificar que el modal se cierra
      cy.contains('¿Estás seguro').should('not.exist');

      // Verificar que el registro sigue en la tabla
      cy.contains('Para Eliminar').should('be.visible');
    });
  });

  describe('Additional Validations', () => {
    it('should handle edge cases', () => {
      // Agregar validaciones adicionales según sea necesario
      // Ejemplos:
      // - Validar límites de caracteres
      // - Validar formatos (email, teléfono, etc.)
      // - Validar comportamiento con datos duplicados
      // - Validar paginación
      // - Validar filtros y búsqueda
    });
  });
});
